# Meta Model API — only muse-spark-1.3-contributor is supported
MODEL_API_KEY=your-meta-model-api-key

# Private Telegram bot. Create a token with BotFather; set your numeric user ID.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_OWNER_ID=123456789

# Game account credentials (never commit your .env)
BOT_USER=your-username
BOT_PASS=your-password

# Optional initial game. 0 means select with /games ID_GAME.
GAME_ID=0
# 0 = discover player from account identity in fresh game state.
# An explicit ID applies only to GAME_ID, if discovery is unavailable.
PLAYER_ID=0

BOT_DB_PATH=data/con-bot.sqlite3
BOT_MAX_ROUNDS=15
BOT_MAX_TOOLS=30
BOT_AUTO_INTERVAL=30
